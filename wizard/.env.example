# Anthropic (optional — users can bring their own key in Step 1)
ANTHROPIC_API_KEY=sk-ant-...

# Figma MCP server URL
# Remote (default, requires OAuth token):
FIGMA_MCP_URL=https://mcp.figma.com/mcp
# Local — free, requires Figma desktop app with Dev Mode MCP enabled:
# FIGMA_MCP_URL=http://127.0.0.1:3845/mcp
# Community (EXDST) — free, read+write, requires local server running:
# FIGMA_MCP_URL=http://localhost:<port>/mcp

# Figma OAuth (https://www.figma.com/developers/apps)
# Only needed for OAuth login in the wizard (PAT mode works without these)
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=    # openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
